# ── Tweets (pick one source in config.yaml → twitter.source) ──
# Official X API filtered stream (needs an X API plan that includes filtered stream).
# Also used for: looking up celebrity user IDs, and the 1-minute tweet engagement check.
X_BEARER_TOKEN=
# Or: any tweet-alert service POSTs tweets to http://<this machine>:8787 with header X-CTMC-Secret
WEBHOOK_SECRET=

# ── Solana data ──
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com    # use a Helius/Triton URL: speed, bubble maps, wallet tracking
SOLANA_WS_URL=                                        # optional; derived from SOLANA_RPC_URL if empty
HELIUS_API_KEY=                                       # scoring KOL wallets from their own swap history
JUPITER_API_KEY=                                      # free at portal.jup.ag (prices, quotes, swaps)
BIRDEYE_API_KEY=                                      # optional: holder counts, unique wallets
PUMPPORTAL_API_KEY=                                   # optional; new-launch stream is free without it

# ── Alerts & remote control ──
TELEGRAM_BOT_TOKEN=                                   # from @BotFather
TELEGRAM_CHAT_ID=                                     # your chat id — only this chat can control the bot
DISCORD_WEBHOOK_URL=

# ── Optional Grok second opinion on X hype (console.x.ai) ──
XAI_API_KEY=

# ── Live trading only. Dedicated hot wallet. NEVER commit the real .env ──
WALLET_PRIVATE_KEY=
