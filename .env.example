# ── Tweets (pick one source in config.yaml → twitter.source) ──
# Official X API filtered stream (needs an X API plan that includes filtered stream)
X_BEARER_TOKEN=
# Or: any tweet-alert service POSTs to http://<this machine>:8787 with header X-CTMC-Secret
WEBHOOK_SECRET=

# ── Data ──
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # use a Helius/Triton URL: needed for speed + bubble maps
BIRDEYE_API_KEY=                                     # optional: holder counts, unique wallets

# ── Optional Grok second opinion on X hype (console.x.ai) ──
XAI_API_KEY=

# ── Live trading only. Dedicated hot wallet. NEVER commit the real .env ──
WALLET_PRIVATE_KEY=
